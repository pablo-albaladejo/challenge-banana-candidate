{
  "name": "challenge-banana-candidate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node --import tsx scripts/setup.ts",
    "reset": "node --import tsx scripts/reset.ts",
    "dev": "node --import tsx scripts/dev.ts",
    "bank": "node --import tsx simulator/server.ts",
    "build": "next build --webpack",
    "start": "node --import tsx scripts/dev.ts --production",
    "ingest": "node --import tsx scripts/ingest.ts",
    "scenario": "node --import tsx scripts/scenario.ts",
    "doctor": "node --import tsx scripts/doctor.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --import ./tests/setup.ts --test \"app/**/*.test.ts\" \"src/**/*.test.ts\" \"simulator/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "lint": "eslint ."
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "dotenv": "17.2.3",
    "next": "16.3.6",
    "openai": "7.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "husky": "^9.1.7",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "^5.9.0"
  }
}
