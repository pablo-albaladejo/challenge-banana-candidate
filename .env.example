# Copy to .env.local. One project key serves both APIs.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Model provider: openai | claude-cli | auto. This template pins openai, the target configuration
# (an unset MODEL_PROVIDER means auto). For local development without OpenAI credit, set
# MODEL_PROVIDER=auto in .env.local: auto uses OpenAI when OPENAI_API_KEY is set, retries a call
# with claude-cli when OpenAI answers 429 insufficient_quota (and then skips OpenAI for 5 minutes),
# and uses claude-cli when the key is blank and the claude binary is installed and logged in.
# claude-cli runs `claude -p` on your Claude subscription; it has no embeddings, so document search
# becomes lexical (SQLite FTS5/BM25).
MODEL_PROVIDER=openai
CLAUDE_CLI_BIN=claude
CLAUDE_CLI_MODEL=haiku
# Optional local ports and simulator address.
APP_PORT=3000
BANK_PORT=4001
BANK_URL=http://127.0.0.1:4001
# Development-only defaults; the evaluator supplies its own values.
BANK_SERVICE_SECRET=banana-local-service
BANK_ADMIN_SECRET=banana-local-admin
SESSION_SECRET=banana-local-session
